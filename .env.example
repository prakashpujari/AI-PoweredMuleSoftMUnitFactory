# =============================================================================
# AI-MUnit-Factory — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=AI-MUnit-Factory
APP_VERSION=1.0.0
APP_ENV=production           # development | staging | production
DEBUG=false
API_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:3000","https://ai-munit-factory.vercel.app"]

# ── Security ──────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Database (Render PostgreSQL 18.3 — Oregon) ───────────────────────────────
# ssl=require is enforced by Render; the app strips it and passes ssl context via connect_args
DATABASE_URL=postgresql+asyncpg://ai_apps_db_nzf4_user:<password>@dpg-d84sbagjo89c73bskf10-a.oregon-postgres.render.com/ai_apps_db_nzf4?ssl=require
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis (Render) ─────────────────────────────────────────────────────────────
REDIS_URL=redis://red-d836e2t7vvec73938sl0:6379
CACHE_TTL_SECONDS=3600

# ── AI Providers ──────────────────────────────────────────────────────────────
# Primary (required) — MUnit generation, failure analysis
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=8192
GROQ_TEMPERATURE=0.1
DEFAULT_AI_PROVIDER=groq

# Secondary (optional) — executive summaries, complex reasoning
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Tertiary fallback (optional)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── Pinecone Vector DB ────────────────────────────────────────────────────────
# Project: Mortgage | Index: mortgageindex
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=mortgageindex
PINECONE_HOST=https://mortgageindex-96hwyzx.svc.aped-4627-b74a.pinecone.io
PINECONE_ENVIRONMENT=aped-4627-b74a
PINECONE_DIMENSION=1536

# ── MuleSoft Anypoint ──────────────────────────────────────────────────────────
ANYPOINT_CLIENT_ID=your_client_id
ANYPOINT_CLIENT_SECRET=your_client_secret
ANYPOINT_ORG_ID=your_org_id
ANYPOINT_ENV_ID=your_env_id
ANYPOINT_BASE_URL=https://anypoint.mulesoft.com

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_ORG=your-github-org
REPO_SCAN_PATH=/repos

# ── Maven ─────────────────────────────────────────────────────────────────────
MVN_HOME=/usr/local/maven
MVN_OPTS=-Xmx2g

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Coverage Thresholds ───────────────────────────────────────────────────────
COVERAGE_TARGET_PERCENT=95.0
MIN_ACCEPTABLE_COVERAGE=80.0
