# ─── AI-MUnit-Factory Environment Configuration ───────────────────────────────
# Copy to .env and fill in real values before running

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=AI-MUnit-Factory
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false
API_PREFIX=/api/v1

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://munit:munit_pass@localhost:5432/munit_factory

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AI Providers (at least one required) ──────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
DEFAULT_AI_PROVIDER=groq

ANTHROPIC_API_KEY=sk-ant-your_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-4o

# ── Pinecone Vector DB ─────────────────────────────────────────────────────────
PINECONE_API_KEY=your_pinecone_key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=munit-factory

# ── MuleSoft Anypoint ──────────────────────────────────────────────────────────
ANYPOINT_CLIENT_ID=your_client_id
ANYPOINT_CLIENT_SECRET=your_client_secret
ANYPOINT_ORG_ID=your_org_id
ANYPOINT_ENV_ID=your_env_id

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_your_github_token
GITHUB_ORG=your-github-org
REPO_SCAN_PATH=/repos

# ── Maven ─────────────────────────────────────────────────────────────────────
MVN_HOME=/usr/local/maven
MVN_OPTS=-Xmx2g

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Coverage ──────────────────────────────────────────────────────────────────
COVERAGE_TARGET_PERCENT=95.0
MIN_ACCEPTABLE_COVERAGE=80.0
